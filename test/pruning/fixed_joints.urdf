      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="fixed_hip_inertia" type="fixed">
    <parent link="HipLink"/>
    <child link="HipLink_inertia"/>
