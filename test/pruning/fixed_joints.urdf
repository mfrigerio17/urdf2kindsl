<?xml version="1.0" encoding="utf-8"?>

<robot name="dummy_leg">

  <link name="world"></link>
  <!-- this nonsense is often found in URDF models -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
  </joint>

  <link name="base">
  </link>

  <joint name="base_to_base_inertia" type="fixed">
    <parent link="base"/>
    <child link="base_inertia"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="base_inertia">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.018 -0.002 0.024"/>
      <mass value="6.222"/>
      <inertia ixx="0.017938806" ixy="0.00387963" ixz="0.001500772" iyy="0.370887745" iyz="6.8963e-05" izz="0.372497653"/>
    </inertial>
  </link>


  <joint name="base_DummyLink" type="fixed">
    <parent link="base"/>
    <child link="DummyLink"/>
    <origin rpy="2.61799387799 0 0.0" xyz="0.2999 0.104 0.0"/>
  </joint>

  <link name="DummyLink">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.063 7e-05 0.00046"/>
      <mass value="2.04"/>
      <inertia ixx="0.001053013" ixy="4.527e-05" ixz="8.855e-05" iyy="0.001805509" iyz="9.909e-05" izz="0.001765827"/>
    </inertial>
  </link>

  <joint name="HAA" type="revolute">
    <parent link="DummyLink"/>
    <child link="HipLink"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

